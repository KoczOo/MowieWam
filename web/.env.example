# -----------------------------------------------------------------------------
# Sekrety serwera — używane wyłącznie po stronie SSR (server.ts).
# NIE trafiają do bundla klienta. Skopiuj do `.env` i uzupełnij wartościami.
# -----------------------------------------------------------------------------

# API key z Google Cloud Console → Places API.
# Rekomendowana restrykcja: IP addresses (IP hostingu produkcyjnego).
GOOGLE_API_KEY=your_google_api_key_here

# Place ID biznesu w Google Maps (format ChIJXXXXXXXXX).
# Znajdź: https://developers.google.com/maps/documentation/places/web-service/place-id
PLACE_ID=your_place_id_here
