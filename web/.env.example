# -----------------------------------------------------------------------------
# Sekrety serwera — używane wyłącznie po stronie SSR (server.ts).
# NIE trafiają do bundla klienta. Skopiuj do `.env` i uzupełnij wartościami.
# Na Hostingerze wklej te same klucze w Environment variables (Import .env).
# -----------------------------------------------------------------------------

# --- Google Places (opinie) ---
# Konsola: https://console.cloud.google.com/ → Places API + klucz z restriction = Places API
GOOGLE_API_KEY=
# Place ID wizytówki (ciąg ChIJ…): https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
PLACE_ID=

# --- Instagram Graph API (posty) ---
# Konto profesjonalne + Meta app. Token long-lived (~60 dni), ID numeryczne (nie @mowie.wam).
IG_ACCESS_TOKEN=
IG_USER_ID=

# --- Contact mailer (Resend REST API) ---
# API key: https://resend.com/api-keys  (bez biblioteki npm — fetch z server.ts)
RESEND_API_KEY=
# Odbiorca zgłoszeń (gabinet) — produkcja: kontakt@mowiewam.pl
CONTACT_TO=mowiewam.logopeda@gmail.com
# Nadawca — po weryfikacji domeny w Resend, np. Mówię Wam <kontakt@mowiewam.pl>
# Do testów lokalnych: Mówię Wam <onboarding@resend.dev>
# UWAGA: z onboarding@resend.dev Resend dostarcza maile TYLKO na e-mail konta Resend.
# Auto-reply do dowolnego adresu z formularza wymaga zweryfikowanej domeny (resend.com/domains).
CONTACT_FROM=Mówię Wam <kontakt@mowiewam.pl>
